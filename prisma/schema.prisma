// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AGENT
  ADMIN
}

enum PolicyType {
  AUTO
  HOME
  RENTERS
  CYCLE
  RV
  ATV
  BOAT
  CLASSIC_CAR
  MEXICO
  UMBRELLA
  JEWELRY
  IDENTITY_THEFT
  GOLF_CART
  RENTAL_HOME
  RENTAL_CONDO
  MANUFACTURED_HOME
  CONDO
}

enum BiLimit {
  LIMIT_25_50
  LIMIT_50_100
  LIMIT_100_300
  LIMIT_250_500
  LIMIT_300_500
  LIMIT_500_500
}

enum BundledWith {
  HOME
  RENTERS
  CYCLE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  salesAsAgent Sale[]   @relation("AgentSales")
  salesEntered Sale[]   @relation("EnteredBySales")
}

model Sale {
  id            String       @id @default(uuid())
  agentId       String
  agent         User         @relation("AgentSales", fields: [agentId], references: [id])
  date          DateTime     @default(now())
  clientName    String
  policyNumber  String
  policyType    PolicyType
  biLimit       BiLimit?
  premiumAmount Decimal
  isBundled     Boolean      @default(false)
  bundledWith   BundledWith?
  isPaidInFull  Boolean      @default(false)
  notes         String?
  isVoided      Boolean      @default(false)
  enteredById   String?
  enteredBy     User?        @relation("EnteredBySales", fields: [enteredById], references: [id])
  createdAt     DateTime     @default(now())
}
